---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import SocialFooter from '../../components/SocialFooter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { makeSquareThumbs } from '../../lib/thumb';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Precompute crisp square thumbnails (1x/2x DPR) from hero images at build time
const items = await Promise.all(
  posts.map(async (post) => {
    const hero = post.data.heroImage;
    if (!hero) return { post, thumbs: null as null | { x1: string; x2: string } };
    try {
      const thumbs = await makeSquareThumbs(hero, 84);
      return { post, thumbs };
    } catch (err) {
      // Fallback to original image if processing fails
      return { post, thumbs: null };
    }
  }),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} ogImageUrl="/og/blog.png" />
		<style>
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li { margin-bottom: 2rem; }

			/* Each post row */
			.post-link {
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: start;
				gap: 0.9rem;
				text-decoration: none;
				color: var(--text-color);
			}

			/* Text column */
			.meta { min-width: 0; }
			.title {
				margin: 0 0 0.3em 0;
				font-size: 1.3em;
				font-weight: bold;
				line-height: 1.3;
				color: var(--text-color);
			}
			.date {
				margin: 0 0 0.7em 0;
				font-size: 0.85em;
				color: var(--gray-text);
			}
			.description {
				margin: 0;
				color: var(--text-color);
				font-size: 0.95em;
				line-height: 1.5;
				opacity: 0.8;
			}

			/* Right-aligned square thumbnail */
                        .thumb {
                                width: 84px;
                                height: 84px;
                                border-radius: 14px;
                                overflow: hidden;
                                flex-shrink: 0;
                                /* Align thumbnail with the top of the text block */
                                align-self: start;
                                border: 1px solid rgba(0, 0, 0, 0.08);
                        }
			.thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			@media (prefers-color-scheme: dark) {
				.thumb { border-color: rgba(255, 255, 255, 0.14); }
			}

			@media (max-width: 520px) {
				.post-link { grid-template-columns: 1fr 72px; gap: 0.7rem; }
				.thumb { width: 72px; height: 72px; border-radius: 12px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
                {
                    items.map(({ post, thumbs }) => (
                        <li>
                            <a class="post-link" href={`/blog/${post.id}/`}>
                                <div class="meta">
                                    <h4 class="title">{post.data.title}</h4>
                                    <p class="date">
                                        <FormattedDate date={post.data.pubDate} />
                                    </p>
                                    <p class="description">{post.data.description}</p>
                                </div>
                                {post.data.heroImage && (
                                    <div class="thumb" aria-hidden="true">
                                        <img
                                            width="84"
                                            height="84"
                                            src={thumbs ? thumbs.x1 : post.data.heroImage}
                                            srcset={thumbs ? `${thumbs.x1} 1x, ${thumbs.x2} 2x` : undefined}
                                            alt=""
                                            loading="lazy"
                                        />
                                    </div>
                                )}
                            </a>
                        </li>
                    ))
                }
				</ul>
			</section>
		</main>
		<SocialFooter />
	</body>
</html>
